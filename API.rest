
@baseUrl = http://localhost:4110
@groupId = 1

### ==========================================
### 1. CREATE GROUP
### ==========================================

# Create a group with 3 participants
# Expected: 201 Created

POST {{baseUrl}}/api/groups
Content-Type: application/json

{
  "name": "Trip Bandung",
  "participants": [
    {
      "name": "Alice"
    },
    {
      "name": "Bob"
    },
    {
      "name": "Charlie"
    }
  ]
}


### ==========================================
### 2. GET GROUP DETAILS
### ==========================================

# Get group details and participants
# Expected: 200 OK

GET {{baseUrl}}/api/groups/{{groupId}}
Accept: application/json


### ==========================================
### 3. CREATE ANOTHER GROUP
### ==========================================

POST {{baseUrl}}/api/groups
Content-Type: application/json

{
  "name": "Weekend Jakarta",
  "participants": [
    {
      "name": "David"
    },
    {
      "name": "Emma"
    }
  ]
}


### ==========================================
### 4. ADD EXPENSE - DINNER
### ==========================================

# Alice pays Rp300.000 for all participants
# Expected: 201 Created

POST {{baseUrl}}/api/groups/{{groupId}}/expenses
Content-Type: application/json

{
  "description": "Dinner",
  "amount": 300000.00,
  "paidByParticipantId": 1,
  "participantIds": [1, 2, 3]
}


### ==========================================
### 5. ADD EXPENSE - TAXI
### ==========================================

# Bob pays Rp90.000 for Bob and Charlie
# Expected: 201 Created

POST {{baseUrl}}/api/groups/{{groupId}}/expenses
Content-Type: application/json

{
  "description": "Taxi",
  "amount": 90000.00,
  "paidByParticipantId": 2,
  "participantIds": [2, 3]
}


### ==========================================
### 6. GET ALL EXPENSES
### ==========================================

# Get all expenses belonging to a group
# Expected: 200 OK

GET {{baseUrl}}/api/groups/{{groupId}}/expenses
Accept: application/json


### ==========================================
### 7. GET SETTLEMENT SUMMARY
### ==========================================

# Calculate debts, service charge and transactions
# Expected: 200 OK

GET {{baseUrl}}/api/groups/{{groupId}}/settlement
Accept: application/json


